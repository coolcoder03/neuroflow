<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<meta name="description" content="NeuroFlow — Rewire your brain in 15 days. Science-backed dopamine reset protocol.">
<meta name="theme-color" content="#03060e">
<title>NeuroFlow — Brain Reset Protocol</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&family=Lato:ital,wght@0,300;0,400;0,700;1,300&display=swap" rel="stylesheet">
<style>
/* ==================== RESET & BASE ==================== */
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
:root{
  --bg:#03060e;--deep:#060b18;--surface:#0b1120;--panel:#0f1729;--card:#111827;
  --glass:rgba(255,255,255,0.04);--gb:rgba(255,255,255,0.08);--gb2:rgba(255,255,255,0.12);
  --cyan:#00e5ff;--cyand:rgba(0,229,255,0.12);--cyanglow:rgba(0,229,255,0.3);
  --violet:#7c3aed;--vd:rgba(124,58,237,0.18);
  --green:#00ffa3;--gd:rgba(0,255,163,0.12);
  --amber:#ffb347;--ad:rgba(255,179,71,0.14);
  --rose:#ff4d8f;--rd:rgba(255,77,143,0.14);
  --sky:#38bdf8;--skyd:rgba(56,189,248,0.12);
  --text:#dde6f5;--muted:#7080a8;--dim:#2d3a55;
  --nav-h:68px;--hdr-h:56px;
  --r:16px;--r2:12px;--r3:8px;--r4:6px;
  --shadow:0 4px 24px rgba(0,0,0,0.5);
}
html,body{height:100%;overflow:hidden;background:var(--bg);color:var(--text);font-family:'Lato',sans-serif;font-size:14px}
button{font-family:inherit;cursor:pointer;border:none;outline:none}
input,select{font-family:inherit;outline:none;border:none;background:none;color:var(--text)}
a{color:var(--cyan);text-decoration:none}
img{max-width:100%}

/* ==================== GRID BG ==================== */
body::before{content:'';position:fixed;inset:0;z-index:0;pointer-events:none;
  background-image:linear-gradient(rgba(0,229,255,0.02) 1px,transparent 1px),
                   linear-gradient(90deg,rgba(0,229,255,0.02) 1px,transparent 1px);
  background-size:48px 48px}

/* ==================== LAYOUT ==================== */
#app{position:fixed;inset:0;display:flex;flex-direction:column;z-index:1;overflow:hidden}

/* HEADER */
.app-header{height:var(--hdr-h);background:var(--surface);border-bottom:1px solid var(--gb);
  display:flex;align-items:center;justify-content:space-between;padding:0 16px;
  flex-shrink:0;position:relative;z-index:10}
.logo{font-family:'Syne',sans-serif;font-size:18px;font-weight:800;
  background:linear-gradient(120deg,var(--cyan),var(--violet));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.beta-badge{background:var(--rd);border:1px solid rgba(255,77,143,.35);color:var(--rose);
  font-family:'DM Mono',monospace;font-size:9px;letter-spacing:1.5px;padding:3px 8px;border-radius:4px}
.hdr-right{display:flex;align-items:center;gap:10px}
.hdr-btn{background:var(--glass);border:1px solid var(--gb);border-radius:8px;
  padding:6px 10px;color:var(--muted);font-size:13px;transition:all .2s}
.hdr-btn:hover{color:var(--text);border-color:var(--gb2)}
.day-indicator{font-family:'DM Mono',monospace;font-size:11px;color:var(--cyan);
  background:var(--cyand);border:1px solid rgba(0,229,255,.25);border-radius:6px;padding:4px 10px}

/* SCREENS */
.screens{flex:1;overflow:hidden;position:relative}
.screen{position:absolute;inset:0;overflow-y:auto;display:none;
  padding:16px 16px calc(var(--nav-h) + 16px);
  scrollbar-width:thin;scrollbar-color:var(--dim) transparent}
.screen.active{display:block}
.screen::-webkit-scrollbar{width:4px}.screen::-webkit-scrollbar-thumb{background:var(--dim)}

/* BOTTOM NAV */
.bottom-nav{height:var(--nav-h);background:var(--surface);border-top:1px solid var(--gb);
  display:flex;align-items:stretch;flex-shrink:0;position:relative;z-index:10}
.nav-item{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:4px;cursor:pointer;padding:8px 4px;transition:all .2s;position:relative}
.nav-item.active{color:var(--cyan)}
.nav-item:not(.active){color:var(--muted)}
.nav-icon{font-size:20px;line-height:1}
.nav-label{font-family:'DM Mono',monospace;font-size:9px;letter-spacing:.5px}
.nav-item.active::after{content:'';position:absolute;top:0;left:25%;right:25%;height:2px;
  background:var(--cyan);border-radius:0 0 3px 3px;box-shadow:0 0 8px var(--cyan)}

/* ==================== COMPONENTS ==================== */
.sec-label{font-family:'DM Mono',monospace;font-size:9px;letter-spacing:3px;text-transform:uppercase;
  color:var(--dim);margin-bottom:6px}
.sec-title{font-family:'Syne',sans-serif;font-size:20px;font-weight:700;margin-bottom:16px}
.card{background:var(--card);border:1px solid var(--gb);border-radius:var(--r);padding:16px;margin-bottom:12px}
.card.c-cyan{border-left:3px solid var(--cyan)}
.card.c-violet{border-left:3px solid var(--violet)}
.card.c-green{border-left:3px solid var(--green)}
.card.c-amber{border-left:3px solid var(--amber)}
.card.c-rose{border-left:3px solid var(--rose)}
.card-title{font-family:'Syne',sans-serif;font-size:13px;font-weight:700;margin-bottom:8px}
.card-body{font-size:13px;color:var(--muted);line-height:1.7}

/* GRID */
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}

/* STAT CARD */
.stat-card{background:var(--card);border:1px solid var(--gb);border-radius:var(--r2);
  padding:14px;text-align:center;display:flex;flex-direction:column;gap:4px}
.stat-val{font-family:'Syne',sans-serif;font-size:26px;font-weight:800}
.stat-label{font-family:'DM Mono',monospace;font-size:9px;color:var(--muted);letter-spacing:1px}
.stat-sub{font-size:11px;color:var(--dim)}

/* PROGRESS BAR */
.prog-wrap{margin:8px 0}
.prog-label{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-bottom:5px}
.prog-bar{height:6px;border-radius:100px;background:var(--gb);overflow:hidden}
.prog-fill{height:100%;border-radius:100px;transition:width .6s ease}

/* PILL TAGS */
.pill{display:inline-block;padding:3px 10px;border-radius:100px;font-family:'DM Mono',monospace;font-size:9.5px}
.pill-c{background:var(--cyand);color:var(--cyan);border:1px solid rgba(0,229,255,.25)}
.pill-v{background:var(--vd);color:#a78bfa;border:1px solid rgba(124,58,237,.25)}
.pill-g{background:var(--gd);color:var(--green);border:1px solid rgba(0,255,163,.25)}
.pill-a{background:var(--ad);color:var(--amber);border:1px solid rgba(255,179,71,.25)}
.pill-r{background:var(--rd);color:var(--rose);border:1px solid rgba(255,77,143,.25)}

/* BUTTON */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;
  padding:11px 20px;border-radius:var(--r3);font-size:13px;font-weight:700;transition:all .2s;cursor:pointer}
.btn-primary{background:var(--cyan);color:#03060e;border:none}
.btn-primary:hover{opacity:.9;transform:translateY(-1px)}
.btn-ghost{background:var(--glass);color:var(--text);border:1px solid var(--gb)}
.btn-ghost:hover{border-color:var(--gb2);background:var(--gb)}
.btn-full{width:100%}
.btn-danger{background:var(--rd);color:var(--rose);border:1px solid rgba(255,77,143,.3)}

/* CHECK ITEM */
.check-item{display:flex;align-items:flex-start;gap:12px;padding:12px 0;
  border-bottom:1px solid var(--gb);cursor:pointer;transition:opacity .2s}
.check-item:last-child{border-bottom:none}
.check-item.done{opacity:.55}
.check-box{width:22px;height:22px;border-radius:6px;border:2px solid var(--gb2);
  flex-shrink:0;margin-top:1px;display:flex;align-items:center;justify-content:center;
  font-size:13px;transition:all .2s}
.check-item.done .check-box{background:var(--cyan);border-color:var(--cyan);color:#03060e}
.check-text{flex:1}
.check-title{font-size:13px;font-weight:700;margin-bottom:3px}
.check-desc{font-size:12px;color:var(--muted);line-height:1.6}
.sci-tag{display:inline-block;background:var(--vd);color:#a78bfa;border:1px solid rgba(124,58,237,.25);
  border-radius:4px;padding:1px 6px;font-family:'DM Mono',monospace;font-size:9px;margin-left:6px;vertical-align:middle}

/* TOAST */
#toast{position:fixed;bottom:calc(var(--nav-h) + 16px);left:50%;transform:translateX(-50%) translateY(20px);
  background:var(--green);color:#03060e;padding:10px 20px;border-radius:100px;
  font-size:13px;font-weight:700;opacity:0;transition:all .3s;z-index:999;white-space:nowrap;pointer-events:none}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* ==================== ONBOARDING ==================== */
#onboarding{position:fixed;inset:0;z-index:100;background:var(--bg);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:24px;overflow-y:auto}
.ob-step{display:none;width:100%;max-width:420px;animation:fadeUp .4s ease}
.ob-step.active{display:flex;flex-direction:column;gap:16px}
@keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
.ob-logo{font-family:'Syne',sans-serif;font-size:42px;font-weight:800;text-align:center;
  background:linear-gradient(130deg,#fff,var(--cyan) 45%,var(--violet));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.ob-sub{text-align:center;color:var(--muted);font-size:14px;line-height:1.7}
.ob-input{background:var(--surface);border:1px solid var(--gb2);border-radius:var(--r2);
  padding:14px 16px;font-size:15px;color:var(--text);width:100%;
  transition:border-color .2s}
.ob-input:focus{border-color:var(--cyan)}
.ob-input::placeholder{color:var(--dim)}
.challenge-opt{padding:12px 16px;border-radius:var(--r2);border:1px solid var(--gb);
  cursor:pointer;transition:all .2s;display:flex;align-items:center;gap:12px;
  background:var(--glass)}
.challenge-opt.sel{border-color:var(--cyan);background:var(--cyand)}
.challenge-opt .co-check{width:20px;height:20px;border-radius:5px;border:2px solid var(--gb2);
  display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0}
.challenge-opt.sel .co-check{background:var(--cyan);border-color:var(--cyan);color:#03060e}
.co-text{font-size:13px}
.ob-dots{display:flex;gap:8px;justify-content:center;margin-top:8px}
.ob-dot{width:8px;height:8px;border-radius:50%;background:var(--gb2);transition:all .3s}
.ob-dot.active{background:var(--cyan);width:20px;border-radius:4px}

/* ==================== DASHBOARD ==================== */
.greeting{font-family:'Syne',sans-serif;font-size:22px;font-weight:700;margin-bottom:4px}
.greeting-sub{font-size:13px;color:var(--muted);margin-bottom:18px}
.day-hero{background:linear-gradient(135deg,var(--cyand),var(--vd));
  border:1px solid rgba(0,229,255,.2);border-radius:var(--r);padding:18px;margin-bottom:16px;
  position:relative;overflow:hidden}
.day-hero::after{content:'';position:absolute;right:-20px;top:-20px;width:120px;height:120px;
  border-radius:50%;background:radial-gradient(circle,rgba(0,229,255,.1),transparent);pointer-events:none}
.day-num-big{font-family:'Syne',sans-serif;font-size:52px;font-weight:800;color:var(--cyan);line-height:1}
.day-phase{font-family:'DM Mono',monospace;font-size:10px;color:var(--muted);letter-spacing:1.5px;margin-bottom:4px}
.day-name{font-family:'Syne',sans-serif;font-size:15px;font-weight:700;margin-bottom:8px}
.day-progress{display:flex;align-items:center;gap:10px;font-size:12px;color:var(--muted)}
.circle-prog{width:42px;height:42px;position:relative;flex-shrink:0}
.circle-prog svg{width:42px;height:42px;transform:rotate(-90deg)}
.circle-prog circle{fill:none;stroke-width:3;stroke-linecap:round}
.circle-bg{stroke:rgba(255,255,255,0.08)}
.circle-fg{stroke:var(--cyan);transition:stroke-dashoffset .6s ease}
.circle-text{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  font-family:'DM Mono',monospace;font-size:10px;color:var(--cyan)}

.quick-actions{display:flex;gap:8px;margin-bottom:16px;overflow-x:auto;padding-bottom:4px;scrollbar-width:none}
.quick-actions::-webkit-scrollbar{display:none}
.qa-btn{flex-shrink:0;background:var(--card);border:1px solid var(--gb);border-radius:var(--r2);
  padding:12px 14px;display:flex;flex-direction:column;align-items:center;gap:6px;
  min-width:80px;cursor:pointer;transition:all .2s}
.qa-btn:hover{border-color:var(--cyan);transform:translateY(-2px)}
.qa-icon{font-size:22px}
.qa-label{font-family:'DM Mono',monospace;font-size:9px;color:var(--muted);white-space:nowrap}

.streak-row{display:flex;gap:4px;margin-top:12px}
.streak-dot{width:28px;height:28px;border-radius:6px;display:flex;align-items:center;
  justify-content:center;font-size:11px;background:var(--glass);border:1px solid var(--gb)}
.streak-dot.done{background:var(--cyand);border-color:rgba(0,229,255,.3)}
.streak-dot.today{border-color:var(--cyan);box-shadow:0 0 8px var(--cyanglow)}

/* ==================== PLAN SCREEN ==================== */
.plan-days-scroll{display:flex;gap:8px;overflow-x:auto;padding-bottom:8px;margin-bottom:18px;scrollbar-width:none}
.plan-days-scroll::-webkit-scrollbar{display:none}
.plan-day-pill{flex-shrink:0;width:48px;text-align:center;cursor:pointer;
  padding:8px 4px;border-radius:var(--r2);border:1px solid var(--gb);
  background:var(--glass);transition:all .2s;font-family:'DM Mono',monospace}
.plan-day-pill .dp-num{font-size:16px;font-weight:700;color:var(--muted)}
.plan-day-pill .dp-dot{width:6px;height:6px;border-radius:50%;background:var(--gb2);margin:4px auto 0}
.plan-day-pill.active{border-color:var(--cyan);background:var(--cyand)}
.plan-day-pill.active .dp-num{color:var(--cyan)}
.plan-day-pill.active .dp-dot{background:var(--cyan)}
.plan-day-pill.completed{border-color:rgba(0,255,163,.3);background:rgba(0,255,163,.06)}
.plan-day-pill.completed .dp-num{color:var(--green)}
.plan-day-pill.completed .dp-dot{background:var(--green)}
.phase-banner{padding:12px 16px;border-radius:var(--r2);margin-bottom:14px;
  font-family:'DM Mono',monospace;font-size:10px;letter-spacing:1px;
  display:flex;align-items:center;gap:8px}
.day-summary-box{background:var(--glass);border-left:3px solid var(--cyan);
  border-radius:0 var(--r3) var(--r3) 0;padding:12px 14px;margin-bottom:14px;
  font-size:13px;color:var(--muted);line-height:1.7}

/* ==================== GAMES SCREEN ==================== */
.game-hub{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px}
.game-card{background:var(--card);border:1px solid var(--gb);border-radius:var(--r);
  padding:16px;cursor:pointer;transition:all .2s;text-align:center}
.game-card:hover{border-color:rgba(0,229,255,.3);transform:translateY(-2px);box-shadow:var(--shadow)}
.game-card.active-game{border-color:var(--cyan);background:var(--cyand)}
.game-emoji{font-size:30px;margin-bottom:8px}
.game-name{font-family:'Syne',sans-serif;font-size:13px;font-weight:700;margin-bottom:4px}
.game-best{font-family:'DM Mono',monospace;font-size:10px;color:var(--muted)}
.game-arena{background:var(--card);border:1px solid var(--gb);border-radius:var(--r);
  padding:18px;margin-bottom:12px;min-height:200px;display:none}
.game-arena.active{display:block}
.game-title{font-family:'Syne',sans-serif;font-size:16px;font-weight:700;color:var(--cyan);margin-bottom:4px}
.game-instructions{font-size:12px;color:var(--muted);margin-bottom:16px;line-height:1.6}
.game-score-display{font-family:'DM Mono',monospace;font-size:12px;color:var(--muted);text-align:center;margin-bottom:12px;min-height:18px}

/* N-BACK */
.nb-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;max-width:200px;margin:0 auto 14px}
.nb-cell{aspect-ratio:1;border-radius:9px;background:var(--glass);border:2px solid var(--gb);transition:all .2s}
.nb-cell.lit{background:var(--cyan);border-color:var(--cyan);box-shadow:0 0 16px var(--cyanglow)}
.game-btns{display:flex;gap:8px;justify-content:center;flex-wrap:wrap}
.gbtn{padding:9px 18px;border-radius:var(--r3);border:1px solid;
  font-family:'DM Mono',monospace;font-size:11px;cursor:pointer;transition:all .15s;
  background:transparent}
.gbtn-c{border-color:var(--cyan);color:var(--cyan)}.gbtn-c:hover{background:var(--cyand)}
.gbtn-r{border-color:var(--rose);color:var(--rose)}.gbtn-r:hover{background:var(--rd)}
.gbtn-g{border-color:var(--green);color:var(--green)}.gbtn-g:hover{background:var(--gd)}
.gbtn-a{border-color:var(--amber);color:var(--amber)}.gbtn-a:hover{background:var(--ad)}
.gbtn-m{border-color:var(--muted);color:var(--muted)}.gbtn-m:hover{background:var(--glass)}

/* REACTION */
.rt-box{width:100%;height:90px;border-radius:var(--r2);background:var(--glass);
  border:2px solid var(--gb);display:flex;align-items:center;justify-content:center;
  cursor:pointer;font-family:'DM Mono',monospace;font-size:13px;color:var(--muted);
  transition:all .15s;user-select:none;margin-bottom:12px}
.rt-box.go{background:var(--gd);border-color:var(--green);color:var(--green)}
.rt-box.wait{background:var(--rd);border-color:var(--rose);color:var(--rose)}

/* SEQ */
.seq-grid{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-bottom:14px}
.seq-btn{width:64px;height:64px;border-radius:12px;border:2px solid var(--gb);
  cursor:pointer;transition:all .15s;font-size:24px;display:flex;align-items:center;justify-content:center}
.seq-btn:hover{transform:scale(1.05)}

/* STROOP */
.stroop-word{font-family:'Syne',sans-serif;font-size:42px;font-weight:800;text-align:center;
  padding:16px;letter-spacing:2px}
.stroop-opts{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}
.stroop-opt{padding:10px;border-radius:var(--r3);border:1px solid var(--gb);
  background:var(--glass);cursor:pointer;font-family:'DM Mono',monospace;font-size:12px;
  color:var(--text);transition:all .1s;font-weight:700}
.stroop-opt:hover{background:var(--gb)}

/* ==================== TIMERS SCREEN ==================== */
.timer-cards{display:grid;gap:12px;margin-bottom:16px}
.timer-card{background:var(--card);border:1px solid var(--gb);border-radius:var(--r);padding:20px}
.timer-label{font-family:'DM Mono',monospace;font-size:10px;letter-spacing:2px;
  text-transform:uppercase;color:var(--muted);margin-bottom:6px}
.timer-display{font-family:'Syne',sans-serif;font-size:52px;font-weight:800;
  color:var(--cyan);text-align:center;letter-spacing:3px;margin:10px 0}
.timer-display.warning{color:var(--amber)}
.timer-display.done{color:var(--green)}
.timer-phase{text-align:center;font-family:'DM Mono',monospace;font-size:11px;color:var(--muted);margin-bottom:12px}
.timer-sessions{font-family:'DM Mono',monospace;font-size:11px;color:var(--muted);text-align:center;margin-top:8px}
.timer-btns{display:flex;gap:8px;justify-content:center}
.cold-level{text-align:center;font-size:24px;margin:8px 0;min-height:36px}

/* ==================== HABITS SCREEN ==================== */
.habit-check{display:flex;align-items:center;justify-content:space-between;
  padding:13px 0;border-bottom:1px solid var(--gb)}
.habit-check:last-child{border-bottom:none}
.habit-left{display:flex;align-items:center;gap:12px}
.habit-icon{font-size:20px}
.habit-info .hn{font-size:13px;font-weight:700}
.habit-info .hd{font-size:11px;color:var(--muted);margin-top:1px}
.habit-toggle{width:44px;height:24px;border-radius:100px;border:2px solid var(--gb2);
  background:var(--glass);cursor:pointer;position:relative;transition:all .3s;flex-shrink:0}
.habit-toggle::after{content:'';position:absolute;width:16px;height:16px;border-radius:50%;
  background:var(--muted);top:2px;left:2px;transition:all .3s}
.habit-toggle.on{background:var(--cyand);border-color:var(--cyan)}
.habit-toggle.on::after{background:var(--cyan);left:22px;box-shadow:0 0 8px var(--cyanglow)}
.habit-week{display:flex;gap:4px;margin-left:auto;padding-left:10px}
.hw-dot{width:24px;height:24px;border-radius:5px;background:var(--glass);border:1px solid var(--gb);
  display:flex;align-items:center;justify-content:center;font-size:9px;color:var(--dim)}
.hw-dot.done{background:var(--cyand);border-color:rgba(0,229,255,.3);color:var(--cyan)}
.hw-dot.today{border-color:var(--cyan)}
.mood-row{display:flex;gap:8px;justify-content:center;margin:12px 0}
.mood-btn{font-size:24px;cursor:pointer;padding:8px;border-radius:10px;border:1px solid var(--gb);
  background:var(--glass);transition:all .15s}
.mood-btn:hover,.mood-btn.sel{background:var(--cyand);border-color:var(--cyan);transform:scale(1.1)}

/* ==================== PROGRESS SCREEN ==================== */
.mini-chart{background:var(--card);border:1px solid var(--gb);border-radius:var(--r);
  padding:16px;margin-bottom:12px}
.chart-bars{display:flex;align-items:flex-end;gap:6px;height:80px;margin-top:12px}
.chart-bar-wrap{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px}
.chart-bar{width:100%;border-radius:4px 4px 0 0;background:var(--cyand);border:1px solid rgba(0,229,255,.2);
  min-height:4px;transition:height .6s ease}
.chart-bar.today{background:var(--cyan);box-shadow:0 0 10px var(--cyanglow)}
.chart-label{font-family:'DM Mono',monospace;font-size:8px;color:var(--muted)}
.achievement{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--gb)}
.achievement:last-child{border-bottom:none}
.ach-icon{font-size:22px}
.ach-info .ai-title{font-size:13px;font-weight:700}
.ach-info .ai-desc{font-size:11px;color:var(--muted)}
.ach-info .ai-locked{color:var(--dim)}

/* ==================== SETTINGS MODAL ==================== */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:50;
  display:none;align-items:flex-end;justify-content:center}
.modal-overlay.open{display:flex}
.modal{background:var(--surface);border-radius:var(--r) var(--r) 0 0;width:100%;max-width:480px;
  padding:24px;max-height:80vh;overflow-y:auto;border-top:1px solid var(--gb);
  animation:slideUp .3s ease}
@keyframes slideUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
.modal-handle{width:40px;height:4px;border-radius:2px;background:var(--gb2);margin:0 auto 20px}
.modal-title{font-family:'Syne',sans-serif;font-size:18px;font-weight:700;margin-bottom:18px}
.setting-row{display:flex;align-items:center;justify-content:space-between;
  padding:12px 0;border-bottom:1px solid var(--gb)}
.setting-row:last-child{border-bottom:none}
.setting-label{font-size:13px;color:var(--text)}
.setting-sub{font-size:11px;color:var(--muted)}

/* ==================== MISC ==================== */
.empty-state{text-align:center;padding:40px 20px;color:var(--muted)}
.empty-state .es-icon{font-size:40px;margin-bottom:12px}
.empty-state .es-text{font-size:14px;line-height:1.6}
.divider{height:1px;background:var(--gb);margin:16px 0}
.badge-row{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}
.science-note{background:var(--vd);border:1px solid rgba(124,58,237,.25);
  border-radius:var(--r3);padding:10px 12px;font-size:11px;color:#a78bfa;line-height:1.6;margin-top:8px}
.completion-banner{background:linear-gradient(135deg,var(--gd),rgba(0,229,255,.08));
  border:1px solid rgba(0,255,163,.25);border-radius:var(--r);padding:16px;text-align:center;margin-bottom:14px;display:none}
.completion-banner.show{display:block}

/* Responsive */
@media(min-width:600px){
  .screens,.bottom-nav{max-width:480px;margin:0 auto}
  #app{align-items:center}
  .screen{border-left:1px solid var(--gb);border-right:1px solid var(--gb)}
}

/* SCROLL INDICATOR */
.scroll-hint{text-align:center;font-family:'DM Mono',monospace;font-size:9px;color:var(--dim);margin-bottom:4px}

/* Loading */
.loading-screen{position:fixed;inset:0;z-index:200;background:var(--bg);
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px}
.loading-logo{font-family:'Syne',sans-serif;font-size:36px;font-weight:800;
  background:linear-gradient(130deg,#fff,var(--cyan),var(--violet));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.loading-bar{width:200px;height:3px;background:var(--gb);border-radius:100px;overflow:hidden}
.loading-fill{height:100%;background:var(--cyan);border-radius:100px;animation:loadbar 1.2s ease forwards}
@keyframes loadbar{from{width:0}to{width:100%}}
.loading-text{font-family:'DM Mono',monospace;font-size:11px;color:var(--muted)}
</style>
</head>
<body>

<!-- LOADING -->
<div class="loading-screen" id="loading">
  <div class="loading-logo">NeuroFlow</div>
  <div class="loading-bar"><div class="loading-fill"></div></div>
  <div class="loading-text">Initialising protocol...</div>
</div>

<!-- ONBOARDING -->
<div id="onboarding" style="display:none">
  <!-- Step 1: Welcome -->
  <div class="ob-step active" id="ob1">
    <div class="ob-logo">NeuroFlow</div>
    <div class="ob-sub">Your 15-day science-backed protocol to reset dopamine, kill procrastination, and build a brain that works for you.</div>
    <div class="science-note">📡 Based on research by Dr. Sanil Rege (PsychScene) & Dr. Andrew Huberman (Stanford Neurobiology)</div>
    <button class="btn btn-primary btn-full" onclick="obNext(1)">Begin My Reset →</button>
    <div class="ob-dots">
      <div class="ob-dot active"></div><div class="ob-dot"></div><div class="ob-dot"></div>
    </div>
  </div>
  <!-- Step 2: Name -->
  <div class="ob-step" id="ob2">
    <div style="font-family:'Syne',sans-serif;font-size:26px;font-weight:700">What should we call you?</div>
    <div class="ob-sub">This helps us personalise your daily experience.</div>
    <input class="ob-input" id="ob-name" placeholder="Your first name..." maxlength="20" autocomplete="off">
    <button class="btn btn-primary btn-full" onclick="obNext(2)">Continue →</button>
    <div class="ob-dots">
      <div class="ob-dot"></div><div class="ob-dot active"></div><div class="ob-dot"></div>
    </div>
  </div>
  <!-- Step 3: Challenges -->
  <div class="ob-step" id="ob3">
    <div style="font-family:'Syne',sans-serif;font-size:22px;font-weight:700">What are you fighting?</div>
    <div class="ob-sub">Select your top challenges — we'll prioritise these each day.</div>
    <div id="challenge-list">
      <div class="challenge-opt sel" onclick="toggleChallenge(this,'procrastination')"><div class="co-check">✓</div><div class="co-text">😔 Procrastination — can't start tasks</div></div>
      <div class="challenge-opt sel" onclick="toggleChallenge(this,'dopamine')"><div class="co-check">✓</div><div class="co-text">⚡ Low motivation / dopamine depletion</div></div>
      <div class="challenge-opt" onclick="toggleChallenge(this,'brainfog')"><div class="co-check"></div><div class="co-text">🌫 Brain fog — can't think clearly</div></div>
      <div class="challenge-opt" onclick="toggleChallenge(this,'doomscroll')"><div class="co-check"></div><div class="co-text">📱 Doomscrolling / phone addiction</div></div>
      <div class="challenge-opt" onclick="toggleChallenge(this,'willpower')"><div class="co-check"></div><div class="co-text">💪 Weak willpower / instant gratification</div></div>
      <div class="challenge-opt" onclick="toggleChallenge(this,'sleep')"><div class="co-check"></div><div class="co-text">😴 Poor sleep / fatigue</div></div>
    </div>
    <button class="btn btn-primary btn-full" onclick="obFinish()">Start My 15-Day Reset 🚀</button>
    <div class="ob-dots">
      <div class="ob-dot"></div><div class="ob-dot"></div><div class="ob-dot active"></div>
    </div>
  </div>
</div>

<!-- MAIN APP -->
<div id="app" style="display:none">
  <!-- Header -->
  <div class="app-header">
    <div class="logo">NeuroFlow</div>
    <div class="hdr-right">
      <div class="day-indicator" id="hdr-day">Day 1</div>
      <span class="beta-badge">BETA</span>
      <button class="hdr-btn" onclick="openSettings()">⚙</button>
    </div>
  </div>

  <!-- Screen container -->
  <div class="screens">

    <!-- ════ DASHBOARD ════ -->
    <div class="screen active" id="screen-home">
      <div class="greeting" id="dash-greeting">Good morning! 👋</div>
      <div class="greeting-sub" id="dash-sub">Let's make today count.</div>

      <!-- Day Hero -->
      <div class="day-hero">
        <div class="day-phase" id="hero-phase">PHASE 1 — RESET</div>
        <div style="display:flex;align-items:flex-end;gap:12px;margin-bottom:8px">
          <div class="day-num-big" id="hero-day">1</div>
          <div style="padding-bottom:8px">
            <div class="day-name" id="hero-name">Digital Detox + Sleep Audit</div>
            <div class="badge-row"><span class="pill pill-c" id="hero-focus">DOPAMINE RESET</span></div>
          </div>
        </div>
        <div class="prog-wrap" style="margin-bottom:8px">
          <div class="prog-label"><span>Today's Progress</span><span id="hero-pct">0%</span></div>
          <div class="prog-bar"><div class="prog-fill" id="hero-prog" style="width:0;background:var(--cyan)"></div></div>
        </div>
        <div class="streak-row" id="streak-row"></div>
      </div>

      <!-- Quick Actions -->
      <div class="scroll-hint">Quick access ›</div>
      <div class="quick-actions">
        <div class="qa-btn" onclick="goTo('plan')"><div class="qa-icon">📅</div><div class="qa-label">Today's Plan</div></div>
        <div class="qa-btn" onclick="goTo('timers')"><div class="qa-icon">⏱</div><div class="qa-label">Focus Timer</div></div>
        <div class="qa-btn" onclick="launchTimer('cold')"><div class="qa-icon">🧊</div><div class="qa-label">Cold Shower</div></div>
        <div class="qa-btn" onclick="launchTimer('nsdr')"><div class="qa-icon">🧘</div><div class="qa-label">NSDR</div></div>
        <div class="qa-btn" onclick="goTo('games')"><div class="qa-icon">🧠</div><div class="qa-label">Brain Games</div></div>
        <div class="qa-btn" onclick="goTo('habits')"><div class="qa-icon">✅</div><div class="qa-label">Habits</div></div>
      </div>

      <!-- Stats Row -->
      <div class="grid3" style="margin-bottom:16px">
        <div class="stat-card"><div class="stat-val" id="stat-streak" style="color:var(--cyan)">0</div><div class="stat-label">Day Streak</div></div>
        <div class="stat-card"><div class="stat-val" id="stat-tasks" style="color:var(--green)">0%</div><div class="stat-label">Overall</div></div>
        <div class="stat-card"><div class="stat-val" id="stat-games" style="color:var(--amber)">0</div><div class="stat-label">Games Played</div></div>
      </div>

      <!-- Today's Top Protocols -->
      <div class="sec-label">Today's Key Protocols</div>
      <div id="dash-protocols"></div>

      <!-- Motivational Science Note -->
      <div id="dash-science" class="science-note" style="margin-bottom:12px"></div>
    </div>

    <!-- ════ PLAN ════ -->
    <div class="screen" id="screen-plan">
      <div class="sec-label">15-Day Protocol</div>
      <div class="sec-title">My Brain Reset Plan</div>

      <!-- Day Pills -->
      <div class="plan-days-scroll" id="plan-pills"></div>

      <!-- Day Detail -->
      <div id="plan-day-detail"></div>
    </div>

    <!-- ════ GAMES ════ -->
    <div class="screen" id="screen-games">
      <div class="sec-label">Cognitive Training</div>
      <div class="sec-title">Brain Games</div>
      <div class="card-body" style="margin-bottom:14px;color:var(--muted)">5 minutes daily trains PFC, working memory & attention circuits. Based on Jaeggi et al. (2008) N-Back research.</div>

      <div class="game-hub" id="game-hub">
        <div class="game-card" onclick="selectGame('nback')">
          <div class="game-emoji">🎯</div>
          <div class="game-name">1-Back Memory</div>
          <div class="game-best" id="gbest-nback">Best: 0</div>
        </div>
        <div class="game-card" onclick="selectGame('reaction')">
          <div class="game-emoji">⚡</div>
          <div class="game-name">Reaction Time</div>
          <div class="game-best" id="gbest-reaction">Best: --ms</div>
        </div>
        <div class="game-card" onclick="selectGame('sequence')">
          <div class="game-emoji">🧩</div>
          <div class="game-name">Color Sequence</div>
          <div class="game-best" id="gbest-sequence">Best: L0</div>
        </div>
        <div class="game-card" onclick="selectGame('stroop')">
          <div class="game-emoji">🎨</div>
          <div class="game-name">Stroop Test</div>
          <div class="game-best" id="gbest-stroop">Best: 0%</div>
        </div>
      </div>

      <!-- Game Arenas -->
      <div class="game-arena" id="arena-nback">
        <div class="game-title">1-Back Working Memory</div>
        <div class="game-instructions">Press ✓ Match if the highlighted cell is in the SAME position as the PREVIOUS round. Trains: working memory, PFC activation. Do 5 minutes daily.</div>
        <div class="game-score-display" id="nback-score">Press Start to begin</div>
        <div class="nb-grid" id="nb-grid">
          <div class="nb-cell" id="nb0"></div><div class="nb-cell" id="nb1"></div><div class="nb-cell" id="nb2"></div>
          <div class="nb-cell" id="nb3"></div><div class="nb-cell" id="nb4"></div><div class="nb-cell" id="nb5"></div>
          <div class="nb-cell" id="nb6"></div><div class="nb-cell" id="nb7"></div><div class="nb-cell" id="nb8"></div>
        </div>
        <div class="game-btns">
          <button class="gbtn gbtn-g" onclick="G.nback.answer(true)">✓ Match</button>
          <button class="gbtn gbtn-r" onclick="G.nback.answer(false)">✗ No Match</button>
          <button class="gbtn gbtn-m" onclick="G.nback.start()">▶ Start</button>
        </div>
      </div>

      <div class="game-arena" id="arena-reaction">
        <div class="game-title">Reaction Time Test</div>
        <div class="game-instructions">Wait for GREEN then click as fast as possible. Don't click on red! PFC inhibitory control. Under 250ms = excellent. 350ms+ = brain fog signal.</div>
        <div class="game-score-display" id="rt-score">Click Start then wait...</div>
        <div class="rt-box" id="rt-box" onclick="G.reaction.click()">Press Start</div>
        <div class="game-btns">
          <button class="gbtn gbtn-g" onclick="G.reaction.start()">▶ Start</button>
          <button class="gbtn gbtn-m" onclick="G.reaction.reset()">↺ Reset</button>
        </div>
      </div>

      <div class="game-arena" id="arena-sequence">
        <div class="game-title">Colour Sequence Memory</div>
        <div class="game-instructions">Watch the sequence, then repeat it in order. Trains hippocampal episodic memory. 7+ symbols = strong memory function.</div>
        <div class="game-score-display" id="seq-score">Press Start to begin</div>
        <div class="seq-grid">
          <button class="seq-btn" style="background:var(--rd);border-color:var(--rose)" onclick="G.sequence.input(0)">🔴</button>
          <button class="seq-btn" style="background:var(--gd);border-color:var(--green)" onclick="G.sequence.input(1)">🟢</button>
          <button class="seq-btn" style="background:var(--cyand);border-color:var(--cyan)" onclick="G.sequence.input(2)">🔵</button>
          <button class="seq-btn" style="background:var(--ad);border-color:var(--amber)" onclick="G.sequence.input(3)">🟡</button>
        </div>
        <div class="game-btns">
          <button class="gbtn gbtn-c" onclick="G.sequence.start()">▶ Start</button>
        </div>
      </div>

      <div class="game-arena" id="arena-stroop">
        <div class="game-title">Stroop Colour-Word Test</div>
        <div class="game-instructions">Select the INK COLOUR of the word — NOT what it says. Forces PFC to override automatic reading. Gold-standard executive control test.</div>
        <div class="game-score-display" id="stroop-score">Press Start to begin</div>
        <div class="stroop-word" id="stroop-word" style="color:var(--muted)">READY</div>
        <div class="stroop-opts">
          <button class="stroop-opt" style="color:#ff4d4d" onclick="G.stroop.answer('RED')">RED</button>
          <button class="stroop-opt" style="color:var(--sky)" onclick="G.stroop.answer('BLUE')">BLUE</button>
          <button class="stroop-opt" style="color:var(--green)" onclick="G.stroop.answer('GREEN')">GREEN</button>
          <button class="stroop-opt" style="color:var(--amber)" onclick="G.stroop.answer('YELLOW')">YELLOW</button>
        </div>
        <div class="game-btns" style="margin-top:12px">
          <button class="gbtn gbtn-c" onclick="G.stroop.start()">▶ Start</button>
          <button class="gbtn gbtn-m" onclick="G.stroop.stop()">■ Stop</button>
        </div>
      </div>
    </div>

    <!-- ════ TIMERS ════ -->
    <div class="screen" id="screen-timers">
      <div class="sec-label">Focus & Recovery</div>
      <div class="sec-title">Protocol Timers</div>

      <!-- Pomodoro -->
      <div class="timer-card c-cyan card" id="pomodoro-card">
        <div class="timer-label">🍅 Pomodoro Focus</div>
        <div class="timer-display" id="pomo-display">25:00</div>
        <div class="timer-phase" id="pomo-phase">Focus Block — Work without distractions</div>
        <div class="timer-btns">
          <button class="btn btn-primary" onclick="T.pomo.toggle()" id="pomo-btn">▶ Start</button>
          <button class="btn btn-ghost" onclick="T.pomo.reset()">↺ Reset</button>
          <button class="btn btn-ghost" onclick="T.pomo.skip()">⏭ Skip</button>
        </div>
        <div class="timer-sessions" id="pomo-sessions">Sessions today: 0</div>
      </div>

      <!-- Cold Shower -->
      <div class="timer-card c-sky card" id="cold-card">
        <div class="timer-label">🧊 Cold Shower Protocol</div>
        <div class="timer-display" id="cold-display">01:30</div>
        <div class="cold-level" id="cold-emoji">❄️</div>
        <div class="timer-phase" id="cold-phase">Raises baseline dopamine +250% for 2–4 hours (Šrámek et al.)</div>
        <div class="timer-btns">
          <button class="btn btn-primary" onclick="T.cold.toggle()" id="cold-btn" style="background:var(--sky);color:#03060e">▶ Start Cold</button>
          <button class="btn btn-ghost" onclick="T.cold.reset()">↺ Reset</button>
        </div>
        <div class="timer-sessions" id="cold-streak">Cold showers this week: 0</div>
      </div>

      <!-- NSDR -->
      <div class="timer-card c-violet card" id="nsdr-card">
        <div class="timer-label">🧘 NSDR / Yoga Nidra</div>
        <div class="timer-display" id="nsdr-display">10:00</div>
        <div class="timer-phase" id="nsdr-phase">Non-Sleep Deep Rest — restores dopamine reserves</div>
        <div class="timer-btns">
          <button class="btn btn-primary" onclick="T.nsdr.toggle()" id="nsdr-btn" style="background:#7c3aed">▶ Begin NSDR</button>
          <button class="btn btn-ghost" onclick="T.nsdr.setMins(10)">10m</button>
          <button class="btn btn-ghost" onclick="T.nsdr.setMins(20)">20m</button>
        </div>
        <div class="science-note" style="margin-top:12px">Stickgold & Walker (2013): NSDR restores neurotransmitter baselines and consolidates learning formed in the preceding wake period.</div>
      </div>
    </div>

    <!-- ════ HABITS ════ -->
    <div class="screen" id="screen-habits">
      <div class="sec-label">Daily Tracking</div>
      <div class="sec-title">Habit Tracker</div>
      <div class="card-body" style="margin-bottom:16px;color:var(--muted)">Track these 7 core habits daily. Each builds a specific neural circuit. Tap to toggle.</div>

      <div class="card" id="habits-card"></div>

      <div class="divider"></div>
      <div class="sec-label">How's your energy today?</div>
      <div class="mood-row" id="mood-row">
        <button class="mood-btn" onclick="setMood(1)" title="Terrible">😫</button>
        <button class="mood-btn" onclick="setMood(2)" title="Low">😕</button>
        <button class="mood-btn" onclick="setMood(3)" title="Okay">😐</button>
        <button class="mood-btn" onclick="setMood(4)" title="Good">🙂</button>
        <button class="mood-btn" onclick="setMood(5)" title="Great">😄</button>
      </div>
      <div id="mood-note" style="text-align:center;font-size:12px;color:var(--muted);margin-bottom:16px"></div>

      <div class="divider"></div>
      <div class="sec-label">This Week</div>
      <div class="card" id="week-card"></div>
    </div>

    <!-- ════ PROGRESS ════ -->
    <div class="screen" id="screen-progress">
      <div class="sec-label">Your Journey</div>
      <div class="sec-title">Progress & Stats</div>

      <!-- Overall Progress -->
      <div class="card c-cyan">
        <div class="card-title" style="color:var(--cyan)">Overall Completion</div>
        <div class="prog-wrap">
          <div class="prog-label"><span id="prog-days-label">Day 1 of 15</span><span id="prog-pct-label">0%</span></div>
          <div class="prog-bar" style="height:10px"><div class="prog-fill" id="prog-overall" style="width:0;background:linear-gradient(90deg,var(--cyan),var(--violet))"></div></div>
        </div>
      </div>

      <!-- Stats -->
      <div class="grid2" style="margin-bottom:14px">
        <div class="stat-card">
          <div class="stat-val" id="prog-streak" style="color:var(--cyan)">0</div>
          <div class="stat-label">Day Streak</div>
          <div class="stat-sub">Keep going!</div>
        </div>
        <div class="stat-card">
          <div class="stat-val" id="prog-protocols" style="color:var(--green)">0</div>
          <div class="stat-label">Protocols Done</div>
          <div class="stat-sub">Total completed</div>
        </div>
        <div class="stat-card">
          <div class="stat-val" id="prog-habits" style="color:var(--amber)">0</div>
          <div class="stat-label">Habits Logged</div>
          <div class="stat-sub">Across all days</div>
        </div>
        <div class="stat-card">
          <div class="stat-val" id="prog-sessions" style="color:var(--violet)">0</div>
          <div class="stat-label">Focus Sessions</div>
          <div class="stat-sub">Pomodoro total</div>
        </div>
      </div>

      <!-- 15-Day Visual -->
      <div class="mini-chart">
        <div class="card-title" style="color:var(--cyan)">15-Day Completion Overview</div>
        <div class="chart-bars" id="chart-bars"></div>
      </div>

      <!-- Habits Chart -->
      <div class="mini-chart">
        <div class="card-title" style="color:var(--green)">Habit Completion Rate</div>
        <div id="habits-chart"></div>
      </div>

      <!-- Achievements -->
      <div class="sec-label" style="margin-top:4px">Achievements</div>
      <div class="card" id="achievements"></div>
    </div>

  </div><!-- end screens -->

  <!-- BOTTOM NAV -->
  <div class="bottom-nav">
    <div class="nav-item active" onclick="goTo('home')"><div class="nav-icon">🏠</div><div class="nav-label">Home</div></div>
