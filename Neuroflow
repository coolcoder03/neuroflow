const S = {
  get:(k,def=null)=>{try{const v=localStorage.getItem('nf_'+k);return v!==null?JSON.parse(v):def}catch{return def}},
  set:(k,v)=>{try{localStorage.setItem('nf_'+k,JSON.stringify(v))}catch{}},
