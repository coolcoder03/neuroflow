window.addEventListener('load', ()=>{
  setTimeout(()=>{
    document.getElementById('loading').style.display='none';
    const user = S.get('user');
    if(!user){ showOnboarding(); }
    else { initApp(user); }
  }, 1400);
});

function showOnboarding(){
  document.getElementById('onboarding').style.display='flex';
}

let obChallenges = ['procrastination','dopamine'];
function toggleChallenge(el, key){
  el.classList.toggle('sel');
  const check = el.querySelector('.co-check');
  if(el.classList.contains('sel')){ check.textContent='✓'; if(!obChallenges.includes(key)) obChallenges.push(key); }
  else { check.textContent=''; obChallenges = obChallenges.filter(c=>c!==key); }
}

function obNext(step){
  if(step===1){ document.getElementById('ob1').classList.remove('active'); document.getElementById('ob2').classList.add('active'); }
  else if(step===2){
    const name = document.getElementById('ob-name').value.trim();
    if(!name){ document.getElementById('ob-name').focus(); return; }
    document.getElementById('ob2').classList.remove('active'); document.getElementById('ob3').classList.add('active');
  }
}

function obFinish(){
  const name = document.getElementById('ob-name').value.trim() || 'Friend';
  const user = { name, challenges: obChallenges, startDate: new Date().toISOString(), version: '0.1.0' };
  S.set('user', user);
  document.getElementById('onboarding').style.display='none';
  initApp(user);
  toast(`Welcome, ${name}! Let's begin your reset. 🚀`);
}

function initApp(user){
  APP.user = user;
  const startDate = new Date(user.startDate);
  const now = new Date();
  const diffDays = Math.floor((now - startDate) / (1000*60*60*24));
  APP.currentDay = Math.min(Math.max(1, diffDays+1), 15);
  APP.viewingDay = APP.currentDay;
  document.getElementById('app').style.display='flex';
  renderAll();
}

function renderAll(){
  renderHeader();
  renderDashboard();
  renderPlan();
  renderHabits();
  renderProgress();
  updateGameBests();
}

