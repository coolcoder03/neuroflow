  document.getElementById('arena-'+id).classList.add('active');
  document.querySelectorAll('.game-card').forEach((c,i)=>{
    const ids=['nback','reaction','sequence','stroop'];
    if(ids[i]===id) c.classList.add('active-game');
  });
  // Scroll to arena
  setTimeout(()=>document.getElementById('arena-'+id).scrollIntoView({behavior:'smooth',block:'nearest'}),100);
  // Track
  const gp=S.get('games_played',0)+1;
  S.set('games_played',gp);
  document.getElementById('stat-games').textContent=gp;
}

function updateGameBests(){
  const gs=S.get('game_scores',{});
  document.getElementById('gbest-nback').textContent='Best: '+(gs.nback||0);
  document.getElementById('gbest-reaction').textContent='Best: '+(gs.reaction?gs.reaction+'ms':'--ms');
  document.getElementById('gbest-sequence').textContent='Best: L'+(gs.sequence||0);
  document.getElementById('gbest-stroop').textContent='Best: '+(gs.stroop||0)+'%';
}
function saveGameScore(game, score){
  const gs=S.get('game_scores',{});
  if(game==='reaction'){ if(!gs.reaction||score<gs.reaction) gs.reaction=score; }
  else { if(!gs[game]||score>gs[game]) gs[game]=score; }
  S.set('game_scores',gs);
  updateGameBests();
}

const G = {
  // === N-BACK ===
  nback: (()=>{
    let seq=[],idx=0,score=0,streak=0,prev=null,curr=null,running=false,timer=null;
    function start(){
      seq=[];idx=0;score=0;streak=0;prev=null;curr=null;running=true;
      if(timer)clearInterval(timer);
      upd();
      next();
      timer=setInterval(()=>{prev=curr;next();},2200);
    }
    function next(){
      document.querySelectorAll('.nb-cell').forEach(c=>c.classList.remove('lit'));
      curr=Math.floor(Math.random()*9);
      seq.push(curr);idx++;
      const cell=document.getElementById('nb'+curr);
      if(cell){cell.classList.add('lit');setTimeout(()=>cell.classList.remove('lit'),900);}
    }
    function answer(match){
      if(!running||seq.length<2)return;
      const correct=(seq[seq.length-1]===seq[seq.length-2]);
      if(match===correct){score++;streak++;if(score%5===0)toast(`🎯 ${score} correct!`);}
      else streak=0;
      upd();saveGameScore('nback',score);
    }
    function upd(){document.getElementById('nback-score').textContent=`Score: ${score} · Streak: ${streak} · Round: ${idx}`;}
    return {start,answer};
  })(),

  // === REACTION ===
  reaction: (()=>{
    let state='idle',start=0,t=null,times=[];
    function doStart(){
      reset();state='waiting';
      const box=document.getElementById('rt-box');
      box.className='rt-box wait';box.textContent='Wait... ⚠️';
      document.getElementById('rt-score').textContent='Stay ready — wait for green!';
      t=setTimeout(()=>{
        start=performance.now();state='go';
        box.className='rt-box go';box.textContent='CLICK NOW! ⚡';
      },1500+Math.random()*3500);
    }
    function click(){
      const box=document.getElementById('rt-box');
      if(state==='go'){
        const ms=Math.round(performance.now()-start);
        times.push(ms);state='idle';
        const avg=Math.round(times.reduce((a,b)=>a+b,0)/times.length);
        const r=ms<200?'🟢 Excellent':ms<280?'🟡 Good':ms<380?'🟠 Average':'🔴 Brain Fog Alert';
        box.className='rt-box';box.textContent=`${ms}ms — Press Start again`;
        document.getElementById('rt-score').textContent=`Last: ${ms}ms · Avg: ${avg}ms · ${r}`;
        saveGameScore('reaction',ms);
        if(ms<200) toast('⚡ Lightning fast!');
      } else if(state==='waiting'){
        clearTimeout(t);state='idle';
        box.className='rt-box';box.textContent='Too early! 😅 Try again';
        document.getElementById('rt-score').textContent='Jumped! Wait for GREEN.';
      }
    }
    function reset(){
      clearTimeout(t);state='idle';times=[];
      const box=document.getElementById('rt-box');
      box.className='rt-box';box.textContent='Press Start';
      document.getElementById('rt-score').textContent='Click Start then wait...';
    }
    return {start:doStart,click,reset};
  })(),

  // === SEQUENCE ===
  sequence: (()=>{
    let target=[],inp=[],playing=false,level=1;
    function doStart(){
      target=[];inp=[];level=1;
      for(let i=0;i<3;i++)target.push(Math.floor(Math.random()*4));
      play();
    }
    function play(){
      playing=true;inp=[];
      document.getElementById('seq-score').textContent=`Level ${level} — Watch the sequence!`;
      let i=0;
      const iv=setInterval(()=>{
        if(i>=target.length){clearInterval(iv);playing=false;document.getElementById('seq-score').textContent=`Level ${level} — Now repeat it!`;return;}
        const btns=document.querySelectorAll('.seq-btn');
        btns[target[i]].style.transform='scale(1.2)';btns[target[i]].style.opacity='1';
        setTimeout(()=>{btns[target[i]].style.transform='scale(1)';btns[target[i]].style.opacity='.7';},400);
        i++;
      },700);
    }
    function input(n){
      if(playing)return;
      inp.push(n);
      const pos=inp.length-1;
      if(inp[pos]!==target[pos]){
        document.getElementById('seq-score').textContent=`❌ Wrong at step ${pos+1}! Level ${level} reached.`;
        saveGameScore('sequence',level);
        setTimeout(doStart,1500);return;
      }
      if(inp.length===target.length){
        level++;target.push(Math.floor(Math.random()*4));
        document.getElementById('seq-score').textContent=`✅ Level ${level}!`;
        if(level%3===0)toast(`🧩 Level ${level} reached!`);
        setTimeout(play,800);
      }
    }
    return {start:doStart,input};
  })(),

  // === STROOP ===
  stroop: (()=>{
    const words=['RED','BLUE','GREEN','YELLOW'];
    const colours={'RED':'#ff4d4d','BLUE':'#38bdf8','GREEN':'#00ffa3','YELLOW':'#ffb347'};
    let curr,ink,score=0,total=0,running=false,t=null;
    function start(){score=0;total=0;running=true;next();}
    function next(){
      curr=words[Math.floor(Math.random()*4)];
      ink=words[Math.floor(Math.random()*4)];
      const el=document.getElementById('stroop-word');
      el.textContent=curr;el.style.color=colours[ink];
      document.getElementById('stroop-score').textContent=`Score: ${score}/${total} — Select the INK colour`;
    }
    function answer(color){
      if(!running)return;
      total++;
      if(color===ink){score++;document.getElementById('stroop-score').textContent=`✅ Correct! ${score}/${total}`;}
      else document.getElementById('stroop-score').textContent=`❌ Ink was ${ink}. ${score}/${total}`;
      const pct=total?Math.round(score/total*100):0;
      saveGameScore('stroop',pct);
      setTimeout(next,400);
    }
    function doStop(){
      running=false;
      const pct=total?Math.round(score/total*100):0;
      document.getElementById('stroop-word').textContent='DONE';
      document.getElementById('stroop-word').style.color='var(--muted)';
      document.getElementById('stroop-score').textContent=`Final: ${score}/${total} = ${pct}%`;
      saveGameScore('stroop',pct);
    }
    return {start,answer,stop:doStop};
  })()
};

// ============================================================
//  TIMERS
// ============================================================
const T = {
  pomo: (()=>{
    let secs=25*60,running=false,interval=null,phase='focus',sessions=0,breaks=0;
    function toggle(){
      if(running){clearInterval(interval);running=false;document.getElementById('pomo-btn').textContent='▶ Resume';}
      else{
        running=true;document.getElementById('pomo-btn').textContent='⏸ Pause';
        interval=setInterval(()=>{
          secs--;
          if(secs<=0){
            clearInterval(interval);running=false;
            if(phase==='focus'){sessions++;S.set('pomo_sessions',S.get('pomo_sessions',0)+1);document.getElementById('stat-games');
              toast('🍅 Focus session complete! Take a break.');
              phase='break';secs=5*60;document.getElementById('pomo-phase').textContent='Break Time — Step away, breathe, hydrate.';
            } else {
              phase='focus';secs=25*60;document.getElementById('pomo-phase').textContent='Focus Block — Work without distractions';
              toast('🎯 Break over! Back to focus.');
            }
            document.getElementById('pomo-btn').textContent='▶ Start';
            document.getElementById('pomo-sessions').textContent=`Sessions today: ${sessions}`;
          }
          render();
        },1000);
      }
    }
    function reset(){clearInterval(interval);running=false;secs=25*60;phase='focus';render();document.getElementById('pomo-btn').textContent='▶ Start';document.getElementById('pomo-phase').textContent='Focus Block — Work without distractions';}
    function skip(){clearInterval(interval);running=false;if(phase==='focus'){phase='break';secs=5*60;document.getElementById('pomo-phase').textContent='Break Time — Step away, breathe, hydrate.';}else{phase='focus';secs=25*60;}render();document.getElementById('pomo-btn').textContent='▶ Start';}
    function render(){
      const m=Math.floor(secs/60),s=secs%60;
      const el=document.getElementById('pomo-display');
      el.textContent=`${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
      el.className='timer-display'+(secs<60?' warning':'')+(secs<=0?' done':'');
    }
    return {toggle,reset,skip};
  })(),

  cold: (()=>{
    let secs=90,running=false,interval=null,total=90;
    const messages=['❄️ Starting... breathe steadily','🌊 Stay calm. Breathe. PFC is activating.','💪 Halfway. Your willpower circuit is growing.','⚡ Almost there. This is where growth happens.','🔥 DONE! +250% dopamine incoming.'];
    function toggle(){
      if(running){clearInterval(interval);running=false;document.getElementById('cold-btn').textContent='▶ Resume';}
      else{
        running=true;document.getElementById('cold-btn').textContent='⏸ Pause';
        interval=setInterval(()=>{
          secs--;
          if(secs<=0){
            clearInterval(interval);running=false;
            document.getElementById('cold-emoji').textContent='🔥';
            document.getElementById('cold-phase').textContent='Completed! Dopamine rising 📈';
            document.getElementById('cold-btn').textContent='▶ Start New';
            const key=dateKey();const h=S.get(`habits_${key}`,{});h.cold=true;S.set(`habits_${key}`,h);
            const w=S.get('cold_week',0)+1;S.set('cold_week',w);
            document.getElementById('cold-streak').textContent=`Cold showers this week: ${w}`;
            toast('🧊 Cold protocol complete! Dopamine restored.');
            return;
          }
          render();
          const pct=1-secs/total;
          const mi=Math.min(4,Math.floor(pct*5));
          document.getElementById('cold-emoji').textContent=messages[mi].split(' ')[0];
          document.getElementById('cold-phase').textContent=messages[mi].split(' ').slice(1).join(' ');
        },1000);
      }
    }
    function reset(){clearInterval(interval);running=false;secs=90;render();document.getElementById('cold-btn').textContent='▶ Start Cold';document.getElementById('cold-emoji').textContent='❄️';document.getElementById('cold-phase').textContent='Raises baseline dopamine +250% for 2–4 hours (Šrámek et al.)';}
    function render(){
      const m=Math.floor(secs/60),s=secs%60;
      document.getElementById('cold-display').textContent=`${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
    }
    render();
    return {toggle,reset};
  })(),

  nsdr: (()=>{
    let totalSecs=10*60,secs=10*60,running=false,interval=null;
    const phases=['Find a comfortable lying position. Close your eyes.','Bring awareness to your breath. Don\'t control it, just observe.','Scan slowly from feet upward. Notice each body part.','You are in a state of restful awareness. Let thoughts drift.','Dopamine and norepinephrine are replenishing now.','Remain still. Your brain is consolidating and restoring.','Gently return your awareness. The session is ending.'];
    function toggle(){
      if(running){clearInterval(interval);running=false;document.getElementById('nsdr-btn').textContent='▶ Resume';}
      else{
        running=true;document.getElementById('nsdr-btn').textContent='⏸ Pause';
        interval=setInterval(()=>{
          secs--;
          if(secs<=0){
            clearInterval(interval);running=false;
            document.getElementById('nsdr-phase').textContent='✨ NSDR Complete — Welcome back.';
            document.getElementById('nsdr-btn').textContent='▶ New Session';
            const key=dateKey();const h=S.get(`habits_${key}`,{});h.nsdr=true;S.set(`habits_${key}`,h);
            toast('🧘 NSDR complete. Neurotransmitters restored.');
            return;
          }
          const m=Math.floor(secs/60),s=secs%60;
          document.getElementById('nsdr-display').textContent=`${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
          const pct=1-secs/totalSecs;
          const pi=Math.min(phases.length-1,Math.floor(pct*phases.length));
          document.getElementById('nsdr-phase').textContent=phases[pi];
        },1000);
      }
    }
    function setMins(m){
      clearInterval(interval);running=false;
      secs=m*60;totalSecs=m*60;
      document.getElementById('nsdr-display').textContent=`${String(m).padStart(2,'0')}:00`;
      document.getElementById('nsdr-btn').textContent='▶ Begin NSDR';
      document.getElementById('nsdr-phase').textContent='Non-Sleep Deep Rest — restores dopamine reserves';
    }
    return {toggle,setMins};
  })()
};

