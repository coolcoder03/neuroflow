function renderPlanPills(){
  const container = document.getElementById('plan-pills');
  container.innerHTML='';
  for(let i=1;i<=15;i++){
    const pill = document.createElement('div');
    pill.className='plan-day-pill';
    const dp = S.get(`day_${i}`,{completed:[]});
    const dd = DAYS[i-1];
    const isComplete = dp.completed.length >= dd.protocols.length;
    if(i===APP.viewingDay) pill.classList.add('active');
    if(isComplete) pill.classList.add('completed');
    if(i>APP.currentDay) pill.style.opacity='0.4';
    pill.innerHTML=`<div class="dp-num">${i}</div><div class="dp-dot"></div>`;
    pill.onclick=()=>{ APP.viewingDay=i; renderPlanPills(); renderPlanDay(i); };
    container.appendChild(pill);
  }
  // Scroll to active
  setTimeout(()=>{
    const activePill = container.querySelector('.active');
    if(activePill) activePill.scrollIntoView({behavior:'smooth',block:'nearest',inline:'center'});
  },100);
}

function renderPlanDay(dayNum){
  const d = DAYS[dayNum-1];
  const dp = S.get(`day_${dayNum}`,{completed:[]});
  const pct = Math.round((dp.completed.length/d.protocols.length)*100);
  const isLocked = dayNum > APP.currentDay;
  const phaseColors = {1:'var(--cyan)',2:'var(--violet)',3:'var(--green)'};
  const phaseBg = {1:'var(--cyand)',2:'var(--vd)',3:'var(--gd)'};

  let html = `
    <div class="phase-banner" style="background:${phaseBg[d.phase]};border:1px solid ${phaseColors[d.phase]}30">
      <span style="color:${phaseColors[d.phase]}">●</span>
      <span style="color:${phaseColors[d.phase]}">PHASE ${d.phase} — ${d.phaseName}</span>
    </div>
    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:12px">
      <div>
        <div style="font-family:'DM Mono',monospace;font-size:10px;color:var(--muted);margin-bottom:4px">DAY ${dayNum} OF 15</div>
        <div style="font-family:'Syne',sans-serif;font-size:19px;font-weight:700;margin-bottom:6px">${d.name}</div>
        <span class="pill pill-${d.phase===1?'c':d.phase===2?'v':'g'}">${d.focus.split('·')[0].trim()}</span>
      </div>
      <div style="text-align:right;flex-shrink:0">
        <div style="font-family:'Syne',sans-serif;font-size:26px;font-weight:800;color:${phaseColors[d.phase]}">${pct}%</div>
        <div style="font-size:11px;color:var(--muted)">${dp.completed.length}/${d.protocols.length} done</div>
      </div>
    </div>
    <div class="day-summary-box">${d.summary}</div>
    <div class="science-note" style="margin-bottom:14px">📡 ${d.science}</div>
    <div class="prog-wrap" style="margin-bottom:16px">
      <div class="prog-bar"><div class="prog-fill" style="width:${pct}%;background:${phaseColors[d.phase]}"></div></div>
    </div>
  `;

  if(isLocked){
    html += `<div class="empty-state"><div class="es-icon">🔒</div><div class="es-text">This day unlocks on Day ${dayNum} of your reset.<br>Keep going — you're on Day ${APP.currentDay}!</div></div>`;
  } else {
    html += '<div class="card" style="padding:0 16px">';
    d.protocols.forEach((p,i)=>{
      const done = dp.completed.includes(i);
      html += `<div class="check-item${done?' done':''}" onclick="toggleProtocol(${dayNum},${i},null,true)">
        <div class="check-box">${done?'✓':''}</div>
        <div class="check-text">
          <div class="check-title">${p.title}</div>
          <div class="check-desc">${p.desc}</div>
          <span class="sci-tag">${p.sci}</span>
        </div>
      </div>`;
    });
    html += '</div>';
    if(pct===100){
      html+=`<div class="completion-banner show" style="margin-top:14px">
        <div style="font-size:32px">🎉</div>
        <div style="font-family:'Syne',sans-serif;font-size:16px;font-weight:700;color:var(--green)">Day ${dayNum} Complete!</div>
        <div style="font-size:12px;color:var(--muted);margin-top:4px">Excellent work. ${dayNum<15?`Day ${dayNum+1} awaits.`:'Protocol complete — you built a better brain.'}</div>
      </div>`;
    }
  }

  document.getElementById('plan-day-detail').innerHTML = html;
}

function toggleProtocol(dayNum, idx, el, rerender=false){
  const dp = S.get(`day_${dayNum}`,{completed:[]});
  const pos = dp.completed.indexOf(idx);
  if(pos>-1) dp.completed.splice(pos,1);
  else { dp.completed.push(idx); toast(DAYS[dayNum-1].protocols[idx].title+' ✓'); }
  dp.lastUpdated = new Date().toISOString();
  S.set(`day_${dayNum}`, dp);

  if(rerender){ renderPlanDay(dayNum); renderPlanPills(); }
  else if(el){
    const done = dp.completed.includes(idx);
    el.classList.toggle('done',done);
    el.querySelector('.check-box').textContent=done?'✓':'';
  }
  renderDashboard();
}

