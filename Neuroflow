function renderDashboard(){
  if(!APP.user) return;
  const hour = new Date().getHours();
  document.getElementById('dash-greeting').textContent = `${hour<12?'Good morning':hour<17?'Good afternoon':'Good evening'}, ${APP.user.name}! 👋`;

  const d = DAYS[APP.currentDay-1];
  document.getElementById('hero-phase').textContent = `PHASE ${d.phase} — ${d.phaseName}`;
  document.getElementById('hero-day').textContent = APP.currentDay;
  document.getElementById('hero-name').textContent = d.name;
  document.getElementById('hero-focus').textContent = d.focus.split('·')[0].trim();
  document.getElementById('hero-focus').style.background = d.phase===1?'var(--cyand)':d.phase===2?'var(--vd)':'var(--gd)';

  // Progress for current day
  const prog = S.get(`day_${APP.currentDay}`, {completed:[]});
  const pct = d.protocols.length ? Math.round((prog.completed.length/d.protocols.length)*100) : 0;
  document.getElementById('hero-prog').style.width = pct+'%';
  document.getElementById('hero-pct').textContent = pct+'%';

  // Streak dots (last 7 days)
  const streakRow = document.getElementById('streak-row');
  streakRow.innerHTML='';
  const dayLabels = ['S','M','T','W','T','F','S'];
  for(let i=6;i>=0;i--){
    const dayNum = APP.currentDay - i;
    const dot = document.createElement('div');
    dot.className='streak-dot';
    if(dayNum>0){
      const dp = S.get(`day_${dayNum}`,{completed:[]});
      const dd = DAYS[dayNum-1];
      if(dp.completed.length >= dd.protocols.length) dot.classList.add('done');
    }
    if(i===0) dot.classList.add('today');
    dot.textContent = new Date(Date.now()-i*86400000).toLocaleDateString('en',{weekday:'narrow'}).charAt(0);
    dot.style.fontSize='10px';
    streakRow.appendChild(dot);
  }

  // Stats
  let totalStreak=0, curStreak=0;
  for(let i=APP.currentDay;i>=1;i--){
    const dp = S.get(`day_${i}`,{completed:[]});
    const dd = DAYS[i-1];
    if(dp.completed.length >= dd.protocols.length) curStreak++;
    else break;
  }
  document.getElementById('stat-streak').textContent=curStreak;
  let totalProtos=0, doneProtos=0;
  for(let i=1;i<=15;i++){
    const dp=S.get(`day_${i}`,{completed:[]});
    totalProtos+=DAYS[i-1].protocols.length;
    doneProtos+=dp.completed.length;
  }
  const overallPct=totalProtos?Math.round((doneProtos/totalProtos)*100):0;
  document.getElementById('stat-tasks').textContent=overallPct+'%';
  document.getElementById('stat-games').textContent=S.get('games_played',0);

  // Today's Top 3 Protocols
  const dashProtos = document.getElementById('dash-protocols');
  dashProtos.innerHTML='';
  const top3 = d.protocols.slice(0,3);
  top3.forEach((p,i)=>{
    const done = prog.completed.includes(i);
    const el = document.createElement('div');
    el.className='check-item'+(done?' done':'');
    el.onclick=()=>toggleProtocol(APP.currentDay,i,el);
    el.innerHTML=`<div class="check-box">${done?'✓':''}</div><div class="check-text"><div class="check-title">${p.title}</div></div>`;
    dashProtos.appendChild(el);
  });

  // Science note
  document.getElementById('dash-science').textContent = `💡 ${d.science}`;
}

