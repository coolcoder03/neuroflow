function getHabitsToday(){
  return S.get(`habits_${dateKey()}`, {});
}
function dateKey(d=new Date()){
  return d.toISOString().split('T')[0];
}
function getHabitStreak(habitId){
  let streak=0, d=new Date();
  for(let i=0;i<60;i++){
    const key=dateKey(new Date(d-i*86400000));
    const h=S.get(`habits_${key}`,{});
    if(h[habitId]) streak++;
    else if(i>0) break;
  }
  return streak;
}

function renderHabits(){
  const today = getHabitsToday();
  const card = document.getElementById('habits-card');
  let html='';
  HABITS_DEF.forEach(h=>{
    const done=!!today[h.id];
    const streak=getHabitStreak(h.id);
    let weekDots='';
    for(let i=6;i>=0;i--){
      const key=dateKey(new Date(Date.now()-i*86400000));
      const hd=S.get(`habits_${key}`,{});
      weekDots+=`<div class="hw-dot${hd[h.id]?' done':''}${i===0?' today':''}">${i===0?'·':''}</div>`;
    }
    html+=`<div class="habit-check">
      <div class="habit-left">
        <div class="habit-icon">${h.icon}</div>
        <div class="habit-info">
          <div class="hn">${h.name}</div>
          <div class="hd">${h.desc}</div>
        </div>
      </div>
      <div style="display:flex;align-items:center;gap:8px">
        ${streak>1?`<span style="font-family:'DM Mono',monospace;font-size:9px;color:${h.streak_color}">🔥${streak}</span>`:''}
        <div class="habit-toggle${done?' on':''}" onclick="toggleHabit('${h.id}',this)"></div>
      </div>
    </div>`;
  });
  card.innerHTML=html;

  // Mood
  const mood=S.get(`mood_${dateKey()}`,0);
  document.querySelectorAll('.mood-btn').forEach((b,i)=>{
    b.classList.toggle('sel', i+1===mood);
  });
  const moodTexts=['','Rough day. Your effort here still counts. 💪','Low energy noted. Cold shower + sunlight will help.','Stable baseline. Keep the protocol going.','Good energy! Your circuits are working.','Excellent! This is what restored dopamine feels like.'];
  document.getElementById('mood-note').textContent=mood?moodTexts[mood]:'';

  // Week card
  const weekCard=document.getElementById('week-card');
  let wHtml='';
  const days=['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
  wHtml+='<div style="display:grid;grid-template-columns:repeat(7,1fr);gap:4px;text-align:center">';
  days.forEach(d=>{ wHtml+=`<div style="font-family:'DM Mono',monospace;font-size:9px;color:var(--dim)">${d}</div>`; });
  for(let i=6;i>=0;i--){
    const key=dateKey(new Date(Date.now()-i*86400000));
    const hd=S.get(`habits_${key}`,{});
    const cnt=HABITS_DEF.filter(h=>hd[h.id]).length;
    const pct=cnt/HABITS_DEF.length;
    const bg=pct>0.7?'var(--cyand)':pct>0.4?'rgba(0,229,255,0.06)':'var(--glass)';
    const bc=pct>0.7?'rgba(0,229,255,.35)':pct>0.4?'rgba(0,229,255,.15)':'var(--gb)';
    wHtml+=`<div style="aspect-ratio:1;border-radius:6px;background:${bg};border:1px solid ${bc};display:flex;align-items:center;justify-content:center;font-family:'DM Mono',monospace;font-size:10px;color:${pct>0.4?'var(--cyan)':'var(--dim)'}">${cnt||''}</div>`;
